/* style.qss */

/* Base container styling */
QWidget {
    background-color: #ffffff;
    font-family: 'Comic Sans MS', 'Chalkboard SE', 'Segoe UI', sans-serif;
    color: #1a1a1a;
}

/* Global label defaults */
QLabel {
    font-size: 16px;
}

/* Specific elements using IDs */
#level {
    font-size: 18px;
    font-weight: normal;
}

#score {
    font-size: 26px;
    font-weight: bold;
}

#question {
    font-size: 28px;
    font-weight: normal;
    qproperty-alignment: 'AlignCenter';
}

/* Styling for your four answer choice buttons to match the image boxes */
QPushButton {
    background-color: #ffffff;
    border: 2px solid #1a1a1a;
    border-radius: 12px;
    font-size: 20px;
    padding: 10px;
    min-height: 35px;
}

QPushButton:hover {
    background-color: #f5f5f5;
}

QPushButton:pressed {
    background-color: #e0e0e0;
}
